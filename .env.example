# ---------------------------------------------------------------------------
# POW & PARTNERS — environment
#
# Copy to .env.local for development, or set these in the host for production.
# Never commit real values. Nothing here is read by the browser except the
# variables prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Enquiry delivery ------------------------------------------------------
# Where /api/enquiry posts each enquiry. Any endpoint that accepts JSON: a CRM,
# an automation hook, or a transactional email API. No vendor is assumed.
# With this unset the endpoint returns 503 and the form reports a failure.
# It never reports success.
ENQUIRY_WEBHOOK_URL=

# Optional. Sent as "Authorization: Bearer <value>" if present.
ENQUIRY_WEBHOOK_TOKEN=

# The mailbox that receives enquiry notifications. Required: with this unset
# the endpoint also returns 503.
ENQUIRY_NOTIFY_EMAIL=

# --- Public contact details ------------------------------------------------
# The address shown on the website. Shown only when CONTACT_EMAIL_VERIFIED is
# also true, because configuring an address proves nothing.
NEXT_PUBLIC_CONTACT_EMAIL=

# Set to true only after a real enquiry has been sent through the live form
# and confirmed as received in that mailbox. Until then the site offers the
# form and prints no address anywhere.
CONTACT_EMAIL_VERIFIED=false

# ---------------------------------------------------------------------------
# Not configurable, recorded here so the list is complete:
#
#   Production domain   lib/data.ts, site.url. Currently
#                       https://www.powandpartners.com and unconfirmed.
#                       Change it there, not here, so the sitemap, the
#                       canonicals and the structured data move together.
#
#   Runtime             The standard Next build on Node. A static export is
#                       refused by next.config.mjs because it cannot serve
#                       the enquiry endpoint.
# ---------------------------------------------------------------------------
